# Local model and embeddings (no API key required)
PROVIDER=ollama
LOCAL_MODEL=qwen3.5:9b
EMBED_MODEL=BAAI/bge-small-en-v1.5
NUM_CTX=8192
DEVICE=cuda
# Set DEVICE=cpu if you are not using CUDA for embeddings.

# Hugging Face: optional authentication for model downloads.
# Public models usually work without a token; gated/private models may require one.
# HF_TOKEN= <your_key>

# LangSmith: some RAG examples load a saved prompt from your workspace.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY= <your_key>
# LANGSMITH_PROJECT=rag-from-scratch-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Tavily: required only for examples that perform web search (CRAG / Adaptive RAG).
# TAVILY_API_KEY= <your_key>

# Optional hosted providers (not needed for local Ollama examples).
# OPENAI_API_KEY= <your_key>
# COHERE_API_KEY= <your_key>
